{
  // Worker SEPARADO do site (ecco-sistema): atendimento pelo WhatsApp (SPEC-FASE2 §C).
  // Recebe as mensagens que a Evolution API entrega (webhook) e responde por ela.
  //
  // SEGREDOS (nunca neste arquivo; gravados com `npx wrangler secret put NOME`):
  //   WEBHOOK_SECRET             senha que a Evolution manda no endereço do webhook
  //   EVOLUTION_API_KEY          chave da instância na Evolution (para enviar)
  //   SUPABASE_SERVICE_ROLE_KEY  chave de servidor do Supabase
  //   OPENAI_API_KEY             chave da API da OpenAI (sem ela, só confirma o recebimento)
  //   WHATSAPP_SERVICE_SECRET    o mesmo segredo gravado no Worker do site (ecco-sistema)
  //   CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET  (opcionais) credencial de serviço do
  //                              Cloudflare Access, quando o endereço do gateway está fechado
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecco-whatsapp",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "vars": {
    "SUPABASE_URL": "https://rcjjwoajuvnrgeuzsgsj.supabase.co",
    // Endereço público do gateway (túnel do Cloudflare) e nome da instância.
    "EVOLUTION_URL": "https://zap.eccoprime.com.br",
    "EVOLUTION_INSTANCE": "Eccoprime Zap",
    "APP_URL": "https://gestao.eccoprime.com.br",
    // Modelo da OpenAI que conversa com a pessoa. Para trocar, mude aqui e publique de novo.
    "OPENAI_MODEL": "gpt-5.4-mini",
    // Modelo da OpenAI que transcreve os áudios.
    "OPENAI_TRANSCRIBE_MODEL": "gpt-transcribe"
  },
  // A cada minuto: envia os avisos pendentes e enfileira os lembretes.
  "triggers": { "crons": ["* * * * *"] },
  // Chamada direta ao Worker do site, para a liberação passar pelas regras dele.
  "services": [{ "binding": "SITE", "service": "ecco-sistema" }],
  "observability": { "enabled": true }
}
