// Configuração do Cloudflare Workers para o apps/web (Next.js via OpenNext).
// Segredos (SUPABASE_SERVICE_ROLE_KEY, ACTIVESOFT_API_TOKEN) NÃO ficam aqui:
// são cadastrados no painel do Cloudflare (Worker → Settings → Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecco-sistema",
  // worker.ts = app do OpenNext + rotina agendada de "Novos alunos".
  "main": "worker.ts",
  // Endereço provisório <nome>.dafarc.workers.dev e prévias por ramo/versão.
  "workers_dev": true,
  "preview_urls": true,
  // Roda o Worker na mesma região do Supabase (us-east-2, Ohio). Sem isso ele
  // roda em São Paulo e cada consulta ao banco faz ida e volta até Ohio
  // (~130 ms); com ~10 consultas por página, 1,5 s só de espera.
  "placement": { "mode": "targeted", "region": "aws:us-east-2" },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ecco-sistema"
    }
  ],
  // Banco da central de anamneses ("Novos alunos"): pool do Cloudflare na
  // frente do Supabase (schema `anamnese`). A senha fica na config do
  // Hyperdrive, não aqui. Cache de consultas DESLIGADO no Hyperdrive
  // (wrangler hyperdrive update ... --caching-disabled true): agenda não pode
  // mostrar horário já ocupado como livre. O localConnectionString é FICTÍCIO: o
  // `opennextjs-cloudflare upload/deploy` exige um valor local mesmo sem usá-lo.
  // Para rodar de verdade localmente, sobrescreva com a variável
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_ANAMNESE_DB.
  "hyperdrive": [
    {
      "binding": "ANAMNESE_DB",
      "id": "6b001abc51b1495dbc1d8c86f3e35b83",
      "localConnectionString": "postgresql://local:local@localhost:5432/local"
    }
  ],
  // E-mails da central (Cloudflare Email Service). O remetente (var MAIL_FROM)
  // precisa ser de um domínio habilitado em Email Sending no painel.
  "send_email": [{ "name": "EMAIL" }],
  // Rotina de Novos alunos a cada 5 min (ver worker.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Variáveis não secretas (lidas em tempo de execução).
  // Segredos da central (AUTH_SECRET, ENCRYPTION_KEY, CRON_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) ficam só no Cloudflare.
  "vars": {
    "INTERNAL_EMAIL_DOMAIN": "editoraeccoprime.com.br,eccoprime.com.br,adm.eccoprime.com.br",
    "APP_URL": "https://ecco-sistema.dafarc.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
