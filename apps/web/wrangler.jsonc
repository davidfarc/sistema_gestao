// Configuração do Cloudflare Workers para o apps/web (Next.js via OpenNext).
// Segredos (SUPABASE_SECRET_KEY, ACTIVESOFT_API_TOKEN) NÃO ficam aqui:
// são cadastrados no painel do Cloudflare (Worker → Settings → Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecco-sistema",
  "main": ".open-next/worker.js",
  // Endereço provisório <nome>.dafarc.workers.dev e prévias por ramo/versão.
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ecco-sistema"
    }
  ],
  // Banco da central de anamneses ("Novos alunos"): pool do Cloudflare na
  // frente do Supabase de São Paulo (schema `anamnese`, porta de transação 6543). A senha fica na config do
  // Hyperdrive, não aqui. Cache de consultas DESLIGADO no Hyperdrive
  // (wrangler hyperdrive update ... --caching-disabled true): agenda não pode
  // mostrar horário já ocupado como livre. O localConnectionString é FICTÍCIO: o
  // `opennextjs-cloudflare upload/deploy` exige um valor local mesmo sem usá-lo.
  // Para rodar de verdade localmente, sobrescreva com a variável
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_ANAMNESE_DB.
  "hyperdrive": [
    {
      "binding": "ANAMNESE_DB",
      "id": "47abd82e77784dafa650ee342da392f1",
      "localConnectionString": "postgresql://local:local@localhost:5432/local"
    }
  ],
  // Variáveis não secretas (lidas em tempo de execução).
  // Segredos da central (AUTH_SECRET, ENCRYPTION_KEY, CRON_SECRET; depois
  // GOOGLE_CLIENT_ID/SECRET e MAIL_API_KEY) ficam só no Cloudflare.
  "vars": {
    "INTERNAL_EMAIL_DOMAIN": "editoraeccoprime.com.br,eccoprime.com.br,adm.eccoprime.com.br",
    "APP_URL": "https://ecco-sistema.dafarc.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
