# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O ".env" tem segredos: não mande por e-mail, chat nem para o repositório.

# Endereço público do gateway, o mesmo configurado no túnel do Cloudflare.
SERVER_URL=https://zap.eccoprime.com.br

# Chave que o sistema usa para falar com a Evolution. Invente uma longa
# (40 letras e números ou mais). A mesma vai para o Cloudflare como segredo.
EVOLUTION_API_KEY=troque-por-uma-chave-longa

# Senha do banco interno do gateway (só existe dentro deste computador).
POSTGRES_PASSWORD=troque-por-outra-senha

# Token do túnel, copiado do painel do Cloudflare (Zero Trust > Tunnels).
TUNNEL_TOKEN=cole-o-token-do-tunel
