# ─────────────────────────────────────────────────────────────────────────────
# Copie para apps/web/.env.local e preencha. NUNCA commitar o .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — projeto na região South America (São Paulo)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# Publishable key (novo formato sb_publishable_...; segura p/ cliente = antiga anon).
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# SECRET key (novo formato sb_secret_... = antiga service_role). Só no servidor,
# jamais no bundle do cliente (sem NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Dominios internos — LISTA separada por virgula, sem espacos.
# Quem tem e-mail destes dominios enxerga o board todo; os demais so veem os
# cards atribuidos a eles.
#
# ATENCAO: a organizacao usa TRES dominios. Deixar de fora qualquer um deles
# marcava a pessoa como externa NO PRIMEIRO LOGIN daquele ambiente. Em 27/08 um
# .env.local com um dominio so rebaixou o Gestor Master em producao. O login nao
# rebaixa mais quem ja existe (ver lib/actor.ts), mas contas NOVAS continuam
# dependendo desta lista estar completa.
INTERNAL_EMAIL_DOMAIN="editoraeccoprime.com.br,eccoprime.com.br,adm.eccoprime.com.br"

# Google OAuth (configurado dentro do Supabase Auth > Providers > Google).
# O Client ID/Secret ficam no painel do Supabase; aqui só para referência local se precisar.
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
